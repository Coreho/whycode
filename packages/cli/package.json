{
  "name": "@koreokorp/whycode",
  "version": "0.1.0-beta.1",
  "description": "Proposes comments that explain what AI-written code does and why, and formats it with your project's formatter. Every change is previewed first.",
  "keywords": [
    "ai",
    "claude",
    "code-comments",
    "formatter",
    "code-review",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coreho/whycode.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Coreho/whycode#readme",
  "bugs": "https://github.com/Coreho/whycode/issues",
  "type": "module",
  "bin": {
    "whycode": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm --filter @koreokorp/whycode... build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.12",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@whycode/core": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
